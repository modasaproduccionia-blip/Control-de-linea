# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.
NODE_ENV=development

# PostgreSQL (docker-compose levanta uno en localhost:5432 con estos datos)
DATABASE_URL=postgresql://control:control@localhost:5432/control_linea

# Autenticación (Auth.js). Genere el secreto con: openssl rand -base64 32
AUTH_SECRET=cambie-este-valor-por-uno-aleatorio-de-32-caracteres
AUTH_URL=http://localhost:3000

# Docker compose: contraseña de PostgreSQL y PIN inicial de los usuarios 1000/2000/3000
POSTGRES_PASSWORD=control
SEED_PIN=

APP_TIMEZONE=America/Lima
LOG_LEVEL=info
SESSION_MAX_AGE_HOURS=12

# Opcional (futuro): Microsoft Entra ID
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=
